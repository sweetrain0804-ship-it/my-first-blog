<!-- 국내주식 대주주 양도소득세 예상 계산기 START -->
<div id="stockTaxCalculator" style="max-width:760px;margin:20px auto;padding:18px;box-sizing:border-box;background:#f7f9fc;border:1px solid #dfe5ee;border-radius:14px;font-family:Arial,'Noto Sans KR',sans-serif;color:#222;">

  <h2 style="text-align:center;color:#1a3d7c;margin:0 0 8px;font-size:24px;">
    국내주식 양도소득세 예상 계산기
  </h2>

  <p style="text-align:center;color:#666;font-size:14px;margin:0 0 20px;">
    2026년 기준 · 국내주식 대주주 중심 간이 계산
  </p>

  <!-- 주식 구분 -->
  <div style="background:#fff;padding:15px;border-radius:10px;margin-bottom:12px;">
    <label style="display:block;font-weight:bold;margin-bottom:7px;">
      주식 구분
    </label>

    <select id="stockType"
      style="width:100%;padding:13px;border:1px solid #ccd3df;border-radius:8px;font-size:16px;background:#fff;box-sizing:border-box;">
      <option value="large">중소기업 외 법인 주식</option>
      <option value="small">중소기업 주식</option>
    </select>
  </div>

  <!-- 대주주 여부 -->
  <div style="background:#fff;padding:15px;border-radius:10px;margin-bottom:12px;">
    <label style="display:block;font-weight:bold;margin-bottom:7px;">
      대주주 여부
    </label>

    <select id="majorShareholder"
      style="width:100%;padding:13px;border:1px solid #ccd3df;border-radius:8px;font-size:16px;background:#fff;box-sizing:border-box;">
      <option value="yes">대주주</option>
      <option value="no">대주주 아님</option>
    </select>

    <div style="font-size:12px;color:#777;margin-top:7px;line-height:1.5;">
      ※ 국내 상장주식은 대주주 여부에 따라 과세 여부가 달라질 수 있습니다.
    </div>
  </div>

  <!-- 보유기간 -->
  <div style="background:#fff;padding:15px;border-radius:10px;margin-bottom:12px;">
    <label style="display:block;font-weight:bold;margin-bottom:7px;">
      보유기간
    </label>

    <select id="holdingPeriod"
      style="width:100%;padding:13px;border:1px solid #ccd3df;border-radius:8px;font-size:16px;background:#fff;box-sizing:border-box;">
      <option value="over1">1년 이상</option>
      <option value="under1">1년 미만</option>
    </select>
  </div>

  <!-- 취득가액 -->
  <div style="background:#fff;padding:15px;border-radius:10px;margin-bottom:12px;">
    <label style="display:block;font-weight:bold;margin-bottom:7px;">
      취득가액
    </label>

    <input id="buyPrice" type="number" min="0"
      placeholder="예: 50000000"
      style="width:100%;padding:13px;border:1px solid #ccd3df;border-radius:8px;font-size:16px;box-sizing:border-box;">
  </div>

  <!-- 양도가액 -->
  <div style="background:#fff;padding:15px;border-radius:10px;margin-bottom:12px;">
    <label style="display:block;font-weight:bold;margin-bottom:7px;">
      양도가액
    </label>

    <input id="sellPrice" type="number" min="0"
      placeholder="예: 100000000"
      style="width:100%;padding:13px;border:1px solid #ccd3df;border-radius:8px;font-size:16px;box-sizing:border-box;">
  </div>

  <!-- 필요경비 -->
  <div style="background:#fff;padding:15px;border-radius:10px;margin-bottom:12px;">
    <label style="display:block;font-weight:bold;margin-bottom:7px;">
      필요경비
    </label>

    <input id="expenses" type="number" min="0" value="0"
      placeholder="예: 증권사 수수료 등"
      style="width:100%;padding:13px;border:1px solid #ccd3df;border-radius:8px;font-size:16px;box-sizing:border-box;">

    <div style="font-size:12px;color:#777;margin-top:7px;">
      ※ 취득·양도 과정에서 인정되는 필요경비를 입력하세요.
    </div>
  </div>

  <!-- 계산 버튼 -->
  <button onclick="calculateStockTax2026()"
    style="width:100%;padding:15px;border:0;border-radius:9px;background:#1a3d7c;color:#fff;font-size:17px;font-weight:bold;cursor:pointer;">
    양도소득세 계산하기
  </button>

  <!-- 결과 -->
  <div id="stockTaxResult"
    style="display:none;margin-top:18px;background:#eef4ff;border-radius:11px;padding:17px;line-height:1.8;">
  </div>

  <!-- 안내 -->
  <div style="margin-top:15px;padding:13px;background:#fff7e6;border-radius:9px;font-size:12px;color:#666;line-height:1.65;">
    <strong>주의사항</strong><br>
    이 계산기는 입력한 양도차익을 기준으로 세금을 간편하게 예상하기 위한 참고용 도구입니다.
    실제 세액은 주식의 종류, 대주주 해당 여부, 보유기간, 손익통산,
    신고 시점 및 기타 세법상 요건에 따라 달라질 수 있습니다.
  </div>

</div>

<script>
function stockMoney(value) {
  return Math.round(value).toLocaleString('ko-KR') + '원';
}

function calculateStockTax2026() {

  var stockType = document.getElementById('stockType').value;
  var major = document.getElementById('majorShareholder').value;
  var holding = document.getElementById('holdingPeriod').value;

  var buy = Number(document.getElementById('buyPrice').value) || 0;
  var sell = Number(document.getElementById('sellPrice').value) || 0;
  var expenses = Number(document.getElementById('expenses').value) || 0;

  if (buy <= 0 || sell <= 0) {
    alert('취득가액과 양도가액을 입력해주세요.');
    return;
  }

  if (sell <= buy + expenses) {

    document.getElementById('stockTaxResult').style.display = 'block';

    document.getElementById('stockTaxResult').innerHTML =
      '<strong style="font-size:18px;">📊 계산 결과</strong><br><br>' +
      '양도차익: <strong>0원 이하</strong><br>' +
      '예상 양도소득세: <strong style="color:#1a3d7c;font-size:20px;">0원</strong><br><br>' +
      '입력한 금액 기준으로 양도차익이 발생하지 않습니다.';

    return;
  }

  /* 양도차익 */
  var gain = sell - buy - expenses;

  /* 기본공제 */
  var basicDeduction = 2500000;

  /* 과세표준 */
  var taxable = Math.max(0, gain - basicDeduction);

  var rate = 0;
  var rateText = '';

  /*
    2026년 국내주식 양도소득세 간이 계산
    중소기업 외 대주주:
      1년 이상: 과세표준 3억원 이하 20%
                 3억원 초과 25% 누진
      1년 미만: 30%
    중소기업 대주주:
      10%
  */

  if (major === 'no') {

    /*
      상장주식 소액주주의 일반적인 장내거래는
      과세대상이 아닌 경우가 있으므로
      본 계산기에서는 '대주주 아님'을
      예상세액 0원으로 처리.
    */

    rate = 0;
    rateText = '대주주 아님';

  } else {

    if (stockType === 'small') {

      rate = 0.10;
      rateText = '10%';

    } else {

      if (holding === 'under1') {

        rate = 0.30;
        rateText = '30%';

      } else {

        if (taxable <= 300000000) {

          rate = 0.20;
          rateText = '20%';

        } else {

          rate = 0.25;
          rateText = '25% (3억원 초과 누진)';

        }

      }

    }

  }

  var nationalTax = 0;

  /*
    3억원 초과 대주주의 경우
    20% 구간 + 25% 초과분 방식으로 계산
  */

  if (
    major === 'yes' &&
    stockType === 'large' &&
    holding === 'over1' &&
    taxable > 300000000
  ) {

    nationalTax =
      (300000000 * 0.20) +
      ((taxable - 300000000) * 0.25);

  } else {

    nationalTax = taxable * rate;

  }

  /*
    지방소득세 = 양도소득세의 10%
  */
  var localTax = nationalTax * 0.10;

  var totalTax = nationalTax + localTax;

  var resultText = '';

  if (major === 'no') {

    resultText =
      '<strong style="font-size:18px;">📊 계산 결과</strong><br><br>' +
      '양도차익: <strong>' + stockMoney(gain) + '</strong><br>' +
      '기본공제: <strong>' + stockMoney(basicDeduction) + '</strong><br>' +
      '과세표준: <strong>' + stockMoney(taxable) + '</strong><br>' +
      '적용구분: <strong>대주주 아님</strong><br><br>' +
      '<div style="background:#fff;padding:12px;border-radius:8px;">' +
      '일반적인 상장주식 장내거래에서 대주주가 아닌 소액주주는 ' +
      '양도소득세 과세대상이 아닌 경우가 많습니다.' +
      '</div>';

  } else {

    resultText =
      '<strong style="font-size:18px;">📊 계산 결과</strong><br><br>' +

      '양도차익: <strong>' + stockMoney(gain) + '</strong><br>' +

      '양도소득 기본공제: <strong>' +
      stockMoney(basicDeduction) +
      '</strong><br>' +

      '과세표준: <strong>' +
      stockMoney(taxable) +
      '</strong><br>' +

      '적용세율: <strong>' +
      rateText +
      '</strong><br>' +

      '양도소득세: <strong>' +
      stockMoney(nationalTax) +
      '</strong><br>' +

      '지방소득세: <strong>' +
      stockMoney(localTax) +
      '</strong><br><br>' +

      '<div style="padding:13px;background:#fff;border-radius:8px;">' +
      '💰 <strong>예상 납부세액</strong><br>' +
      '<span style="font-size:23px;color:#d32f2f;font-weight:bold;">' +
      stockMoney(totalTax) +
      '</span>' +
      '</div>';

  }

  document.getElementById('stockTaxResult').style.display = 'block';
  document.getElementById('stockTaxResult').innerHTML = resultText;
}
</script>

<!-- 국내주식 대주주 양도소득세 예상 계산기 END -->
