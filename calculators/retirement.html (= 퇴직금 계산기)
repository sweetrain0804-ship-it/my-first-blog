<!-- 퇴직금 간이 계산기 시작 -->
<div style="max-width: 100%; border: 1px solid #ddd; border-radius: 10px; padding: 18px; font-family: sans-serif; background: #fafafa;">
  <h3 style="text-align: center; color: #1a3d7c; margin-top: 0;">퇴직금 간이 계산기</h3>
  <p style="font-size: 13px; color: #666; text-align: center; margin-top: -5px;">입사일·퇴사일·최근 3개월 급여를 입력하면 예상 퇴직금을 확인할 수 있어요</p>

  <div style="margin-bottom: 12px;">
    <label style="display: block; font-size: 14px; margin-bottom: 4px;">입사일</label>
    <input type="date" id="startDate" style="width: 100%; padding: 8px; box-sizing: border-box; border: 1px solid #ccc; border-radius: 6px;">
  </div>

  <div style="margin-bottom: 12px;">
    <label style="display: block; font-size: 14px; margin-bottom: 4px;">퇴사일</label>
    <input type="date" id="endDate" style="width: 100%; padding: 8px; box-sizing: border-box; border: 1px solid #ccc; border-radius: 6px;">
  </div>

  <div style="margin-bottom: 15px;">
    <label style="display: block; font-size: 14px; margin-bottom: 4px;">최근 3개월 총 급여 (세전, 원)</label>
    <input type="number" id="threeMonthPay" placeholder="예: 9000000" style="width: 100%; padding: 8px; box-sizing: border-box; border: 1px solid #ccc; border-radius: 6px;">
    <p style="font-size: 12px; color: #999; margin: 4px 0 0 0;">퇴직 전 3개월간 받은 급여 총액(세전)을 더해서 입력하세요</p>
  </div>

  <button onclick="calcRetire()" style="width: 100%; padding: 12px; background: #1a3d7c; color: #fff; border: none; border-radius: 6px; font-size: 15px; cursor: pointer;">퇴직금 계산하기</button>

  <div id="resultBox" style="display: none; margin-top: 15px; padding: 12px; background: #eef2fb; border-radius: 8px;">
    <p id="resDays" style="margin: 5px 0; font-size: 14px;"></p>
    <p id="resAvgWage" style="margin: 5px 0; font-size: 14px;"></p>
    <p id="resRetire" style="margin: 5px 0; font-size: 16px; font-weight: bold; color: #1a3d7c;"></p>
  </div>

  <!-- 하단 면책 설명문 -->
  <div style="margin-top: 20px; padding-top: 12px; border-top: 1px solid #ddd;">
    <p style="margin: 0 0 5px 0; font-size: 12px; color: #999;">
      · 본 계산기는 근로기준법상 기본 공식(1일 평균임금 × 30일 × 재직일수÷365)만 적용한 간이 추정치입니다.<br>
      · 상여금, 연차수당, 통상임금 등 실제 평균임금 산정 항목이 반영되지 않아 실제 금액과 차이가 있을 수 있습니다.<br>
      · 정확한 퇴직금은 고용노동부 퇴직금 계산기 또는 회사 인사담당자를 통해 확인하시기 바랍니다.
    </p>
  </div>
</div>

<script>
function calcRetire() {
  var start = new Date(document.getElementById('startDate').value);
  var end = new Date(document.getElementById('endDate').value);
  var threeMonthPay = Number(document.getElementById('threeMonthPay').value) || 0;

  if (!document.getElementById('startDate').value || !document.getElementById('endDate').value || threeMonthPay <= 0) {
    alert('입사일, 퇴사일, 최근 3개월 급여를 모두 입력해주세요.');
    return;
  }

  var msPerDay = 1000 * 60 * 60 * 24;
  var totalDays = Math.round((end - start) / msPerDay);

  if (totalDays <= 0) {
    alert('퇴사일은 입사일보다 나중이어야 합니다.');
    return;
  }

  // 최근 3개월을 약 91일로 가정해 1일 평균임금 산정
  var periodDays = 91;
  var avgWage = threeMonthPay / periodDays;

  var retirementPay = avgWage * 30 * (totalDays / 365);

  document.getElementById('resDays').innerText = '총 재직일수: ' + totalDays.toLocaleString() + '일';
  document.getElementById('resAvgWage').innerText = '1일 평균임금(추정): ' + Math.round(avgWage).toLocaleString() + '원';
  document.getElementById('resRetire').innerText = '예상 퇴직금: ' + Math.round(retirementPay).toLocaleString() + '원';
  document.getElementById('resultBox').style.display = 'block';
}
</script>
<!-- 퇴직금 간이 계산기 끝 -->
