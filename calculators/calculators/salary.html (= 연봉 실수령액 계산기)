<!-- 2026년 연봉 실수령액 간이 계산기 시작 -->
<div style="max-width: 100%; border: 1px solid #ddd; border-radius: 10px; padding: 18px; font-family: sans-serif; background: #fafafa;">
  <h3 style="text-align: center; color: #1a3d7c; margin-top: 0;">2026년 연봉 실수령액 계산기</h3>
  <p style="font-size: 13px; color: #666; text-align: center; margin-top: -5px;">세전 연봉을 입력하면 4대보험 공제 후 예상 실수령액을 확인할 수 있어요</p>

  <div style="margin-bottom: 15px;">
    <label style="display: block; font-size: 14px; margin-bottom: 4px;">세전 연봉 (원)</label>
    <input type="number" id="annualSalary" placeholder="예: 40000000" style="width: 100%; padding: 8px; box-sizing: border-box; border: 1px solid #ccc; border-radius: 6px;">
  </div>

  <button onclick="calcSalary()" style="width: 100%; padding: 12px; background: #1a3d7c; color: #fff; border: none; border-radius: 6px; font-size: 15px; cursor: pointer;">실수령액 계산하기</button>

  <div id="resultBox" style="display: none; margin-top: 15px; padding: 12px; background: #eef2fb; border-radius: 8px;">
    <p id="resMonthlyGross" style="margin: 5px 0; font-size: 14px;"></p>
    <p id="resPension" style="margin: 5px 0; font-size: 13px; color: #555;"></p>
    <p id="resHealth" style="margin: 5px 0; font-size: 13px; color: #555;"></p>
    <p id="resLongterm" style="margin: 5px 0; font-size: 13px; color: #555;"></p>
    <p id="resEmployment" style="margin: 5px 0; font-size: 13px; color: #555;"></p>
    <p id="resTotalDeduct" style="margin: 8px 0 5px 0; font-size: 14px; font-weight: bold;"></p>
    <p id="resNet" style="margin: 5px 0; font-size: 16px; font-weight: bold; color: #1a3d7c;"></p>
  </div>

  <!-- 하단 면책 설명문 -->
  <div style="margin-top: 20px; padding-top: 12px; border-top: 1px solid #ddd;">
    <p style="margin: 0 0 5px 0; font-size: 12px; color: #999;">
      · 본 계산기는 2026년 기준 4대보험 근로자 부담분(국민연금 4.75%, 건강보험 3.595%, 장기요양 건강보험료의 13.14%, 고용보험 0.9%)만 반영한 간이 추정치입니다.<br>
      · 소득세·지방소득세는 부양가족 수, 비과세 항목 등에 따라 달라지므로 이 계산에는 포함되지 않았습니다.<br>
      · 정확한 실수령액은 국세청 홈택스 간이세액표 또는 4대사회보험 정보연계센터에서 확인하시기 바랍니다.
    </p>
  </div>
</div>

<script>
function calcSalary() {
  var annual = Number(document.getElementById('annualSalary').value) || 0;
  var monthlyGross = annual / 12;

  var pension = Math.round(monthlyGross * 0.0475);
  var health = Math.round(monthlyGross * 0.03595);
  var longterm = Math.round(health * 0.1314);
  var employment = Math.round(monthlyGross * 0.009);

  var totalDeduct = pension + health + longterm + employment;
  var net = monthlyGross - totalDeduct;

  document.getElementById('resMonthlyGross').innerText = '세전 월급여: ' + Math.round(monthlyGross).toLocaleString() + '원';
  document.getElementById('resPension').innerText = '국민연금 (4.75%): -' + pension.toLocaleString() + '원';
  document.getElementById('resHealth').innerText = '건강보험 (3.595%): -' + health.toLocaleString() + '원';
  document.getElementById('resLongterm').innerText = '장기요양보험: -' + longterm.toLocaleString() + '원';
  document.getElementById('resEmployment').innerText = '고용보험 (0.9%): -' + employment.toLocaleString() + '원';
  document.getElementById('resTotalDeduct').innerText = '4대보험 공제 합계: -' + totalDeduct.toLocaleString() + '원';
  document.getElementById('resNet').innerText = '예상 월 실수령액 (소득세 제외): ' + Math.round(net).toLocaleString() + '원';
  document.getElementById('resultBox').style.display = 'block';
}
</script>
<!-- 2026년 연봉 실수령액 간이 계산기 끝 -->
