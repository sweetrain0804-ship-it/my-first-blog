<!-- 해외주식 양도소득세 간이 계산기 시작 -->
<div style="max-width: 100%; border: 1px solid #ddd; border-radius: 10px; padding: 18px; font-family: sans-serif; background: #fafafa;">
  <h3 style="text-align: center; color: #1a3d7c; margin-top: 0;">해외주식 양도소득세 간이 계산기</h3>
  <p style="font-size: 13px; color: #666; text-align: center; margin-top: -5px;">매도·매수 금액만 입력하면 예상 세액을 바로 확인할 수 있어요</p>

  <div style="margin-bottom: 12px;">
    <label style="display: block; font-size: 14px; margin-bottom: 4px;">매도 금액 (원)</label>
    <input type="number" id="sellPrice" placeholder="예: 30000000" style="width: 100%; padding: 8px; box-sizing: border-box; border: 1px solid #ccc; border-radius: 6px;">
  </div>

  <div style="margin-bottom: 12px;">
    <label style="display: block; font-size: 14px; margin-bottom: 4px;">매수 금액 (원)</label>
    <input type="number" id="buyPrice" placeholder="예: 20000000" style="width: 100%; padding: 8px; box-sizing: border-box; border: 1px solid #ccc; border-radius: 6px;">
  </div>

  <div style="margin-bottom: 15px;">
    <label style="display: block; font-size: 14px; margin-bottom: 4px;">필요경비 (수수료 등, 원)</label>
    <input type="number" id="expense" placeholder="예: 100000" style="width: 100%; padding: 8px; box-sizing: border-box; border: 1px solid #ccc; border-radius: 6px;">
  </div>

  <button onclick="calcTax()" style="width: 100%; padding: 12px; background: #1a3d7c; color: #fff; border: none; border-radius: 6px; font-size: 15px; cursor: pointer;">세금 계산하기</button>

  <div id="resultBox" style="display: none; margin-top: 15px; padding: 12px; background: #eef2fb; border-radius: 8px;">
    <p id="resProfit" style="margin: 5px 0; font-size: 14px;"></p>
    <p id="resTaxable" style="margin: 5px 0; font-size: 14px;"></p>
    <p id="resTax" style="margin: 5px 0; font-size: 16px; font-weight: bold; color: #1a3d7c;"></p>
  </div>

  <!-- 하단 면책 설명문 -->
  <div style="margin-top: 20px; padding-top: 12px; border-top: 1px solid #ddd;">
    <p style="margin: 0 0 5px 0; font-size: 12px; color: #999;">
      · 본 계산기는 해외주식 양도차익에 대한 기본공제(연 250만 원)와 세율(지방소득세 포함 22%)만 적용한 간이 추정치입니다.<br>
      · 실제 신고 시에는 환율 적용 방식, 여러 종목 손익 통산, 분납 여부 등에 따라 금액이 달라질 수 있습니다.<br>
      · 정확한 세액 산출 및 신고는 반드시 국세청 홈택스 또는 세무 전문가와 상담하시기 바랍니다.
    </p>
  </div>
</div>

<script>
function calcTax() {
  var sell = Number(document.getElementById('sellPrice').value) || 0;
  var buy = Number(document.getElementById('buyPrice').value) || 0;
  var exp = Number(document.getElementById('expense').value) || 0;

  var profit = sell - buy - exp;
  if (profit < 0) profit = 0;

  var taxable = profit - 2500000;
  if (taxable < 0) taxable = 0;

  var tax = Math.round(taxable * 0.22);

  document.getElementById('resProfit').innerText = '양도차익: ' + profit.toLocaleString() + '원';
  document.getElementById('resTaxable').innerText = '과세표준 (기본공제 250만원 차감): ' + taxable.toLocaleString() + '원';
  document.getElementById('resTax').innerText = '예상 납부세액 (22%): ' + tax.toLocaleString() + '원';
  document.getElementById('resultBox').style.display = 'block';
}
</script>
<!-- 해외주식 양도소득세 간이 계산기 끝 -->
